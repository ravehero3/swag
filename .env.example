# Database
DATABASE_URL=postgresql://user:password@host:5432/voodoo808

# Session
SESSION_SECRET=your-secret-key-here-change-in-production

# Environment
NODE_ENV=production

# Production site URL (no trailing slash) — used for OAuth callbacks, emails, GoPay return URLs
APP_URL=https://voodoo808.com

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: override redirect URI if it differs from APP_URL + /api/auth/google/callback
# GOOGLE_CALLBACK_URL=https://voodoo808.com/api/auth/google/callback
