# Database
DATABASE_URL=postgresql://user:password@host:5432/voodoo808

# Session
SESSION_SECRET=your-secret-key-here-change-in-production

# Environment
NODE_ENV=production

# Production site URL (no trailing slash) — used for OAuth callbacks, emails, GoPay return URLs
APP_URL=https://voodoo808.com

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: override redirect URI if it differs from APP_URL + /api/auth/google/callback
# GOOGLE_CALLBACK_URL=https://voodoo808.com/api/auth/google/callback

# Resend (transactional email — required for existing purchase/free-download/reset emails)
# RESEND_API_KEY=
# RESEND_FROM=VOODOO808 <info@voodoo808.com>

# Marketing automation (Resend webhook signature verification — see
# https://resend.com/docs/dashboard/webhooks/verify-webhooks-requests).
# Required for bounce/complaint/open/click tracking on marketing emails.
# Without it, POST /api/webhooks/resend rejects all requests (fails closed).
# RESEND_WEBHOOK_SECRET=
#
# Marketing send mode is stored in the `settings` table (marketing_email_mode),
# editable from Admin → Nastavení → Marketing e-maily. It defaults to "test" on
# a fresh install so no historical lead/customer ever receives an email until
# an admin explicitly switches to "production".
